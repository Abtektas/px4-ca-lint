CA_SV_CS0_TRQ_P 0.5
CA_SV_CS0_TRQ_Y 0.5
CA_SV_CS1_TYPE 6
CA_SV_CS1_TRQ_P 0.5
CA_SV_CS1_TRQ_Y -0.5
