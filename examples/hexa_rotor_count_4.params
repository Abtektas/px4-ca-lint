# A hexarotor X whose CA_ROTOR_COUNT was left at 4: PX4 allocates to rotors 0 to 3
# only and ignores the parameters of rotors 4 and 5.
CA_AIRFRAME 0
CA_ROTOR_COUNT 4
CA_ROTOR0_PX 0
CA_ROTOR0_PY 0.25
CA_ROTOR0_KM -0.05
CA_ROTOR1_PX 0
CA_ROTOR1_PY -0.25
CA_ROTOR1_KM 0.05
CA_ROTOR2_PX 0.2165
CA_ROTOR2_PY -0.125
CA_ROTOR2_KM -0.05
CA_ROTOR3_PX -0.2165
CA_ROTOR3_PY 0.125
CA_ROTOR3_KM 0.05
CA_ROTOR4_PX 0.2165
CA_ROTOR4_PY 0.125
CA_ROTOR4_KM 0.05
CA_ROTOR5_PX -0.2165
CA_ROTOR5_PY -0.125
CA_ROTOR5_KM -0.05
